FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
      gfortran gcc g++ make cmake ninja-build meson python3 python3-pip \
      libopenblas-dev liblapack-dev pkg-config git ca-certificates \
      openbabel python3-numpy time bc \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /opt
COPY xtb /opt/xtb-src
RUN mkdir -p /opt/work
